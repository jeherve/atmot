{
  "name": "atmot",
  "version": "1.0.0",
  "description": "AT Mot — a bilingual (EN/FR) daily word game native to the AT Protocol. No application database: player data lives in each player's PDS, reads come from the Constellation backlink index.",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "private": true,
  "homepage": "https://atmot.herve.bzh",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:words": "tsx scripts/build-wordlists.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "lexicons:validate": "tsx scripts/validate-lexicons.ts",
    "lexicons:publish": "tsx scripts/publish-lexicons.ts"
  },
  "dependencies": {
    "@atcute/client": "^5.1.0",
    "@atcute/identity-resolver": "^2.0.0",
    "@atcute/oauth-browser-client": "^4.0.0"
  },
  "devDependencies": {
    "@atcute/atproto": "^4.0.2",
    "@atcute/bluesky": "^4.0.10",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "an-array-of-french-words": "^2.0.0",
    "eslint": "^9.17.0",
    "happy-dom": "^20.10.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
